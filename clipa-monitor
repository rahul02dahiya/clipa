#!/bin/bash

# Path to your clipboard history file
HISTORY_FILE="$HOME/.clipboard_history.txt"
CLIPNOTIFYPATH="$HOME/.local/bin/clipnotify"
LOCK_FILE="/tmp/clipa.lock"
PID_FILE="/tmp/clipa-monitor.pid"

# --- Single-instance guard ---
# Prevents two copies of this daemon racing on the same clipboard events
# (which was silently doubling/tripling entries history file).
if [ -f "$PID_FILE" ]; then
    OLD_PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
        echo "clipa-monitor is already running (PID $OLD_PID). Exiting."
        exit 1
    fi
fi
echo $$ > "$PID_FILE"
trap 'rm -f "$PID_FILE"' EXIT

# Ensure history file exists so utilities don't throw errors
touch "$HISTORY_FILE"

# Core formatting block handled via a single-pass optimized function
process_and_save() {
    local raw_clip="$1"
    if [ -z "$raw_clip" ]; then
        return
    fi

    # Anti-loop check: Ignore the event if clipa-menu created the lock file
    if [ -f "$LOCK_FILE" ]; then
        return
    fi

    # Flatten multi-line content onto one row using the same placeholder
    # scheme clipa-menu already knows how to decode.
    local encoded
    encoded=$(printf '%s' "$raw_clip" | awk 'BEGIN{ORS="[NEWLINE_PLACEHOLDER]"} {print}')
    encoded="${encoded%\[NEWLINE_PLACEHOLDER\]}"

    local last_saved
    last_saved=$(tail -n 1 "$HISTORY_FILE" 2>/dev/null)

    # Only append if this is genuinely different from the last entry
    if [ "$encoded" != "$last_saved" ]; then
        echo "$encoded" >> "$HISTORY_FILE"
    fi
}

echo "Clipa background engine active..."

# ENGINE MODE 1: WAYLAND DETECTION (e.g., Ubuntu 22 without Sudo)
if [ -n "$WAYLAND_DISPLAY" ]; then
    echo "Wayland environment detected! Using native watch protocols..."
    export -f process_and_save
    export HISTORY_FILE
    export LOCK_FILE

    # Event-driven mechanism completely native to Wayland user space
    wl-paste --type text --watch bash -c 'process_and_save "$(cat)"'
    exit 0
fi

# ENGINE MODE 2: X11 MONITORING (e.g., Kali Linux with compiled clipnotify)
if [ -f "$CLIPNOTIFYPATH" ]; then
    echo "X11 environment detected! Using compiled clipnotify hook..."
    while "$CLIPNOTIFYPATH"; do
        CURRENT_CLIP=$(xclip -selection clipboard -o 2>/dev/null)
        process_and_save "$CURRENT_CLIP"
    done
else
    echo "Error: Neither Wayland display nor clipnotify binary found."
    echo "Please run setup.sh to configure the platform dependencies correctly."
    exit 1
fi